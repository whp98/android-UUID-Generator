<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night). -->
    <style name="Theme.UuidGenerator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/md3_dark_primary</item>
        <item name="colorOnPrimary">@color/md3_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md3_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md3_dark_onPrimaryContainer</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/md3_dark_secondary</item>
        <item name="colorOnSecondary">@color/md3_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md3_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md3_dark_onSecondaryContainer</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">@color/md3_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md3_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md3_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md3_dark_onTertiaryContainer</item>

        <!-- Error color. -->
        <item name="colorError">@color/md3_dark_error</item>
        <item name="colorOnError">@color/md3_dark_onError</item>
        <item name="colorErrorContainer">@color/md3_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md3_dark_onErrorContainer</item>

        <!-- Neutral / Background colors. -->
        <item name="android:windowBackground">@color/md3_dark_background</item>
        <item name="android:colorBackground">@color/md3_dark_background</item>
        <item name="colorOnBackground">@color/md3_dark_onBackground</item>
        <item name="colorSurface">@color/md3_dark_surface</item>
        <item name="colorOnSurface">@color/md3_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md3_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md3_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md3_dark_outline</item>

        <!-- Status bar and navigation bar customizations. -->
        <item name="android:statusBarColor">@color/md3_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/md3_dark_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>